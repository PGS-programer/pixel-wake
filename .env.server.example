# Copy to .env.server for local server configuration. No paid services required.
PORT=3001
HOST=0.0.0.0
DATABASE_PATH=server/data/pixel-wake.sqlite
# Extra frontend origins, comma-separated, only when served separately.
# Same-origin production requests are accepted without this setting.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
