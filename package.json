{
  "name": "pixel-wake",
  "description": "Pixel Wake — arcade marítimo con Phaser 4 y Vite",
  "version": "2.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config vite/config.dev.mjs",
    "build": "vite build --config vite/config.prod.mjs",
    "dev-nolog": "vite --config vite/config.dev.mjs",
    "build-nolog": "vite build --config vite/config.prod.mjs",
    "test": "node --test tests/*.test.js",
    "server": "node --env-file-if-exists=.env.server server/index.js",
    "test:online": "node tests/backend.integration.js",
    "test:browser": "node tests/browser.integration.cjs",
    "preview": "vite preview --config vite/config.prod.mjs --host 127.0.0.1 --port 4173",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "backend:cloud:dev": "wrangler dev --port 8787 --ip 127.0.0.1",
    "backend:cloud:deploy": "wrangler deploy"
  },
  "devDependencies": {
    "terser": "^5.39.0",
    "vite": "^6.4.4",
    "wrangler": "^4.151.0"
  },
  "dependencies": {
    "phaser": "4.0.0",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
